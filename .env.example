# Copy to .env and fill in as each account comes online.
# Everything defaults to `local`, so the system runs with none of these set.

# --- FalkorDB (memory) ------------------------------------------------
# Local (running now, via redis + the falkordb module in .local/):
FALKOR_HOST=localhost
FALKOR_PORT=6379
# FalkorDB Cloud: replace with the instance host/port and credentials
# FALKOR_HOST=<something>.falkordb.cloud
# FALKOR_PORT=<port>
# FALKOR_USERNAME=falkordb
# FALKOR_PASSWORD=

# --- RocketRide (motion) ----------------------------------------------
MOTION_BACKEND=local          # local | cloud
ROCKETRIDE_URI=https://api.rocketride.ai
# ROCKETRIDE_AUTH=            # token is shown ONCE at creation, save it
ROCKETRIDE_PIPELINE=overlap-matchmaker

# --- LaserData (real-time) --------------------------------------------
STREAM_BACKEND=local          # local | laser
# LASER_HOST=
# LASER_PORT=8090
# LASER_USERNAME=iggy
# LASER_PASSWORD=
LASER_STREAM=overlap
LASER_TOPIC=events

# --- Guild.ai (coordination) ------------------------------------------
GUILD_BACKEND=local           # local | guild
# GUILD_API_KEY=
# GUILD_WORKSPACE=

# --- LLM used for the nudge copy (optional) ---------------------------
# ANTHROPIC_API_KEY=
OVERLAP_MODEL=claude-sonnet-5

# --- critic tuning ----------------------------------------------------
NUDGE_COOLDOWN=25
MIN_SHARED_TOPICS=1
